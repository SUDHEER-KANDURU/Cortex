# =============================================================================
# Cortex — Docker Environment Variables
# Copy this to .env in the docker/ directory and fill in your values.
# =============================================================================

# GitHub personal access token (raises API limit from 60→5000 req/hr)
GITHUB_TOKEN=

# NVIDIA NIM API key (for AI-powered chat — optional, falls back to rule-based)
NIM_API_KEY=

# Secret for internal pipeline callback endpoints
INTERNAL_SECRET=change-me-to-random-string

# JWT secret for authentication (MUST change in production)
JWT_SECRET=change-me-in-production

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
